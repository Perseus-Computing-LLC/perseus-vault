{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perseus.observer/schemas/perseus-vault-benchmark-report-v1.json",
  "title": "Perseus Vault benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "suite_version",
    "control_profile_sha256",
    "run_fingerprint_sha256",
    "status",
    "capabilities",
    "cases",
    "metrics",
    "not_measured",
    "excluded",
    "public_evidence",
    "raw_inputs_captured",
    "result_signature_sha256",
    "binary_sha256",
    "dataset_sha256",
    "harness_commit",
    "claims_sha256",
    "claim_ids",
    "negative_claim_ids"
  ],
  "properties": {
    "schema_version": {"const": "perseus-vault-benchmark-report/v1"},
    "benchmark_id": {"$ref": "#/$defs/publicIdentifier"},
    "suite_version": {"$ref": "#/$defs/publicIdentifier"},
    "control_profile_sha256": {"$ref": "#/$defs/sha256"},
    "run_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["passed", "failed", "blocked", "partial"]},
    "capabilities": {"$ref": "#/$defs/statusMap"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "metrics": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/publicIdentifier"}, "additionalProperties": {"$ref": "#/$defs/metric"}},
    "not_measured": {"type": "array", "items": {"$ref": "#/$defs/publicIdentifier"}},
    "excluded": {"type": "array", "items": {"$ref": "#/$defs/publicIdentifier"}},
    "public_evidence": {"const": "hash-only"},
    "raw_inputs_captured": {"const": false},
    "network_calls": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
    "result_signature_sha256": {"$ref": "#/$defs/sha256"},
    "binary_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "harness_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "claims_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark": {"$ref": "#/$defs/publicIdentifier"},
    "dataset": {"$ref": "#/$defs/publicIdentifier"},
    "harness_version": {"$ref": "#/$defs/publicIdentifier"},
    "binary": {"$ref": "#/$defs/publicIdentifier"},
    "required_categories": {"type": "array", "items": {"$ref": "#/$defs/publicIdentifier"}},
    "metric_rates": {"type": "object", "propertyNames": {"$ref": "#/$defs/publicIdentifier"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["available", "partial", "unavailable", "not_measured", "failed"]}, "rate": {"type": "number", "minimum": 0, "maximum": 1}}, "allOf": [{"if": {"properties": {"status": {"enum": ["partial", "unavailable", "not_measured"]}}, "required": ["status"]}, "then": {"not": {"required": ["rate"]}}}]}},
    "offline": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "checks_passed": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
    "checks_total": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
    "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "signature_sha256": {"$ref": "#/$defs/sha256"},
    "claim_ids": {"type": "array", "items": {"$ref": "#/$defs/publicIdentifier"}},
    "negative_claim_ids": {"type": "array", "items": {"$ref": "#/$defs/publicIdentifier"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statusMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/publicIdentifier"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"enum": ["available", "partial", "unavailable", "not_measured", "failed"]},
          "reason": {"$ref": "#/$defs/publicIdentifier"},
          "required_tools": {"type": "array", "items": {"$ref": "#/$defs/publicIdentifier"}},
          "missing_tools": {"type": "array", "items": {"$ref": "#/$defs/publicIdentifier"}},
          "details": {"type": "object", "additionalProperties": false},
          "count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["partial", "unavailable", "not_measured", "failed"]}}, "required": ["status"]}, "then": {"required": ["reason"]}},
          {"if": {"properties": {"status": {"const": "available"}}, "required": ["status"]}, "then": {"anyOf": [{"not": {"required": ["missing_tools"]}}, {"properties": {"missing_tools": {"maxItems": 0}}}]}}
        ]
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "checks", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/publicIdentifier"},
        "category": {"$ref": "#/$defs/publicIdentifier"},
        "status": {"enum": ["passed", "failed", "blocked", "unavailable", "not_measured"]},
        "checks": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/publicIdentifier"}, "additionalProperties": {"type": "boolean"}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "failure_class": {"$ref": "#/$defs/publicIdentifier"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "partial", "unavailable", "not_measured", "failed"]},
        "numerator": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "denominator": {"type": "integer", "minimum": 1, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "rate": {"type": "number", "minimum": 0, "maximum": 1},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "value": {"type": "number", "minimum": 0},
        "reason": {"$ref": "#/$defs/publicIdentifier"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}, "required": ["status"]},
          "then": {"anyOf": [
            {"required": ["numerator", "denominator", "rate"]},
            {"required": ["p50_ms", "p95_ms", "p99_ms"]},
            {"required": ["value"]}
          ]}
        },
        {
          "if": {"properties": {"status": {"enum": ["partial", "unavailable", "not_measured", "failed"]}}, "required": ["status"]},
          "then": {"required": ["reason"]}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "found": {"type": "boolean"},
        "matched": {"type": "boolean"},
        "target_key_present": {"type": "boolean"},
        "truth_key_present": {"type": "boolean"},
        "contamination_key_present": {"type": "boolean"},
        "other_workspace_key_present": {"type": "boolean"},
        "receipt_present": {"type": "boolean"},
        "lease_released": {"type": "boolean"},
        "raw_inputs_captured": {"const": false},
        "stage_trace_checked": {"type": "boolean"},
        "author_key_present": {"type": "boolean"},
        "other_key_present": {"type": "boolean"},
        "current_key_present": {"type": "boolean"},
        "superseded_evidence_present": {"type": "boolean"},
        "inside_found": {"type": "boolean"},
        "outside_found": {"type": "boolean"},
        "shared_profile_personal_key_present": {"type": "boolean"},
        "personal_profile_key_present": {"type": "boolean"},
        "live_key_present": {"type": "boolean"},
        "prior_version_content_present": {"type": "boolean"},
        "other_workspace_visible": {"type": "boolean"},
        "origin_present": {"type": "boolean"},
        "empty_abstained": {"type": "boolean"},
        "pending_health_present": {"type": "boolean"},
        "proposed_requires_review": {"type": "boolean"},
        "untrusted_authoritative": {"type": "boolean"},
        "hostile_marker_visible": {"type": "boolean"},
        "selected_a": {"type": "boolean"},
        "selected_b": {"type": "boolean"},
        "count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "denominator": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "numerator": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "rank": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "ranked_key_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "total": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "entities_archived": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "entities_examined": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "budget_chars": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "injected_chars": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "total_chars": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "frozen_key_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "on_demand_entities": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "always_inject_entities": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "always_inject_budget": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "always_inject_injected_chars": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "always_inject_total_chars": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "on_demand_budget": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "on_demand_injected_chars": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "on_demand_total_chars": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "history_total": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "scoped_key_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "seed_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "core_field_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "core_field_total": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "current_row_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "authority_version": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "external_ref_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "provenance_field_count": {"type": "integer", "minimum": 0, "maximum": 17498005798264095394980017816940970922825355447145699491406164851279623993595007385788105416184430591},
        "rate": {"type": "number", "minimum": 0, "maximum": 1},
        "digest": {"$ref": "#/$defs/sha256"},
        "evidence_hash": {"$ref": "#/$defs/sha256"},
        "frozen_digest": {"$ref": "#/$defs/sha256"},
        "intent_hash": {"$ref": "#/$defs/sha256"},
        "outcome_hash": {"$ref": "#/$defs/sha256"},
        "temporal_digest": {"$ref": "#/$defs/sha256"},
        "profiles_compared": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/publicIdentifier"}
        },
        "capability": {"$ref": "#/$defs/publicIdentifier"},
        "category": {"$ref": "#/$defs/publicIdentifier"},
        "check": {"$ref": "#/$defs/publicIdentifier"},
        "failure_class": {"$ref": "#/$defs/publicIdentifier"},
        "mode": {"$ref": "#/$defs/publicIdentifier"},
        "reason": {"$ref": "#/$defs/publicIdentifier"},
        "scope": {"$ref": "#/$defs/publicIdentifier"},
        "status": {"$ref": "#/$defs/publicIdentifier"},
        "empty_status": {"$ref": "#/$defs/publicIdentifier"},
        "pending_status": {"$ref": "#/$defs/publicIdentifier"},
        "proposed_outcome": {"$ref": "#/$defs/publicIdentifier"},
        "untrusted_outcome": {"$ref": "#/$defs/publicIdentifier"},
        "evidence_mode": {"$ref": "#/$defs/publicIdentifier"},
        "save_outcome_class": {"enum": ["save", "drop", "block", "pending_approval"]},
        "drop_outcome_class": {"enum": ["save", "drop", "block", "pending_approval"]},
        "block_outcome_class": {"enum": ["save", "drop", "block", "pending_approval"]},
        "pending_outcome_class": {"enum": ["save", "drop", "block", "pending_approval"]},
        "proposed_outcome_class": {"enum": ["save", "drop", "block", "pending_approval"]},
        "save_serveable": {"type": "boolean"},
        "drop_no_raw_content": {"type": "boolean"},
        "block_no_raw_content": {"type": "boolean"},
        "pending_not_serveable": {"type": "boolean"},
        "proposed_not_serveable": {"type": "boolean"}
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "publicIdentifier": {
      "type": "string",
      "allOf": [
        {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
        {"not": {"pattern": ".*[Pp][Rr][Ii][Vv][Aa][Tt][Ee].*"}},
        {"not": {"pattern": ".*[Qq][Uu][Ee][Rr][Yy].*"}},
        {"not": {"pattern": ".*[Tt][Oo][Kk][Ee][Nn].*"}},
        {"not": {"pattern": ".*[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll].*"}},
        {"not": {"pattern": ".*[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd].*"}},
        {"not": {"pattern": ".*[Ss][Ee][Cc][Rr][Ee][Tt].*"}},
        {"not": {"pattern": ".*[Bb][Oo][Dd][Yy].*"}}
      ]
    }
