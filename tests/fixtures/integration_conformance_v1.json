{
  "contract_version": "perseus-vault-integration-conformance/v1",
  "vault_schema_version": "2.22.x",
  "purpose": "Reusable synthetic contract for adapter behavior; no credentials or raw memory bodies.",
  "cases": [
    {
      "id": "remember_idempotent",
      "operation": "remember",
      "request": {"category": "decision", "key": "repeatable-key", "workspace_hash": "hash-a", "payload_digest": "sha256"},
      "expected": [
        "same logical key does not create duplicate active entities",
        "correction or supersession remains inspectable"
      ]
    },
    {
      "id": "workspace_isolation",
      "operation": "recall",
      "request": {"workspace_a": "hash-a", "workspace_b": "hash-b", "query_digest": "sha256"},
      "expected": [
        "workspace A cannot recall workspace B memory",
        "empty result is distinct from backend failure"
      ]
    },
    {
      "id": "empty_recall",
      "operation": "recall",
      "request": {"workspace_hash": "empty-scope", "query": "unseen topic"},
      "expected": [
        "empty recall is a valid response",
        "adapter does not manufacture context"
      ]
    },
    {
      "id": "timeout_or_backend_error",
      "operation": "health",
      "request": {"timeout_seconds": 1, "failure_policy": "observable_error"},
      "expected": [
        "timeout or unavailable backend is observable",
        "failure is not reported as a successful empty recall"
      ]
    },
    {
      "id": "forget_preserves_history",
      "operation": "forget",
      "request": {"category": "decision", "key": "repeatable-key", "workspace_hash": "hash-a"},
      "expected": [
        "forget/revocation changes active visibility",
        "historical state remains auditable"
      ]
    },
    {
      "id": "provenance_projection",
      "operation": "recall",
      "request": {"workspace_hash": "hash-a", "source_class": "asserted", "report_mode": "hash-only"},
      "expected": [
        "source class and workspace scope are hash-bindable",
        "raw memory bodies are excluded from conformance reports"
      ]
    },
    {
      "id": "outcome_state_semantics",
      "operation": "context",
      "request": {"mode": "on_demand", "workspace_hash": "hash-a"},
      "expected": [
        "complete is reserved for a successful bounded context result",
        "degraded records an explicit compatibility policy",
        "abstain prevents injection when compilation fails"
      ]
    }
  ],
  "report_requirements": {
    "required_fields": [
      "contract_version",
      "adapter",
      "adapter_version",
      "vault_version",
      "results"
    ],
    "result_fields": ["case_id", "status", "evidence_digest"],
    "statuses": ["pass", "fail", "degraded", "skip"]
  }
}
